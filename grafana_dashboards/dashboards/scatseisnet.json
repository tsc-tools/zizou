        "onclick": "// Event handling\n\n// 'data', 'variables', 'options', 'utils', and 'event' are passed as arguments\n\ntry {\n  const { type: eventType, data: eventData } = event;\n  const { timeZone, dayjs, locationService, getTemplateSrv } = utils;\n\n  switch (eventType) {\n    case 'click':\n      console.log('Click event:', eventData.points);\n      const starttime = new Date(eventData.points[0].text);\n      const endtime = new Date(starttime.getTime() + 20 * 60 * 1000);\n      const starthour = new Date(starttime);\n      const endhour = new Date(starttime);\n      starthour.setMinutes(0, 0, 0);\n      endhour.setMinutes(0, 0, 0);\n      endhour.setHours(starthour.getHours() + 1);\n      locationService.partial(\n        {\n            'var-starttime': starttime.toISOString()\n          \n        },\n        true\n      )\n      locationService.partial(\n      {\n            'var-endtime': endtime.toISOString()\n      },\n       true\n      )\n      locationService.partial(\n      {\n            'var-starthour': starthour.toISOString()\n      },\n       true\n      )\n      locationService.partial(\n      {\n            'var-endhour': endhour.toISOString()\n      },\n       true\n      )\n      console.log('Value of starttime: ', starttime.toISOString());\n      console.log('Value of endtime: ', endtime.toISOString());\n      break;\n    case 'select':\n      console.log('Selection event:', eventData.range);\n      break;\n    case 'zoom':\n      console.log('Zoom event:', eventData);\n      break;\n    default:\n      console.log('Unhandled event type:', eventType, eventData);\n  }\n\n  console.log('Current time zone:', timeZone);\n  console.log('From time:', dayjs(variables.__from).format());\n  console.log('To time:', dayjs(variables.__to).format());\n\n  // Example of using locationService\n  // locationService.partial({ 'var-example': 'test' }, true);\n\n} catch (error) {\n  console.error('Error in onclick handler:', error);\n}\n\n  ",
        "resScale": 2,
        "script": "// Basic timeseries plot\n\n// 'data', 'variables', 'options', and 'utils' are passed as arguments\nif (!Date.prototype.toISOString) {\n  (function() {\n\n    function pad(number) {\n      var r = String(number);\n      if (r.length === 1) {\n        r = '0' + r;\n      }\n      return r;\n    }\n\n    Date.prototype.toISOString = function() {\n      return this.getUTCFullYear() +\n        '-' + pad(this.getUTCMonth() + 1) +\n        '-' + pad(this.getUTCDate()) +\n        'T' + pad(this.getUTCHours()) +\n        ':' + pad(this.getUTCMinutes()) +\n        ':' + pad(this.getUTCSeconds()) +\n        '.' + String((this.getUTCMilliseconds() / 1000).toFixed(3)).slice(2, 5) +\n        'Z';\n    };\n\n  }());\n}\n\nlet series = data.series[0];\nlet x = series.fields[1];\nlet y = series.fields[2];\nlet dates = series.fields[0];\nconsole.log(dates, Array.isArray(dates));\nconst dateTimestamps = dates.values.map(d => new Date(d).getTime());\nconst dateStrings = dates.values.map(d => new Date(d).toISOString())\n// Choose evenly spaced ticks for the colorbar\nconst numTicks = 5;\nconst minTimestamp = Math.min(...dateTimestamps);\nconst maxTimestamp = Math.max(...dateTimestamps);\nconst tickvals = [];\nconst ticktext = [];\n\nfor (let i = 0; i < numTicks; i++) {\n      const ts = minTimestamp + (i / (numTicks - 1)) * (maxTimestamp - minTimestamp);\n      tickvals.push(ts);\n      ticktext.push(new Date(ts).toISOString().slice(0, 10)); // YYYY-MM-DD format\n}\n\nreturn {\n  data: [{\n    x: x.values || x.values.buffer,\n    y: y.values || y.values.buffer,\n    text: dateStrings,\n    type: 'scatter',\n    mode: 'markers',\n    marker: {\n      size: 5,\n      color: dateTimestamps,\n      colorscale: \"Viridis\",\n      colorbar: {\n        title: \"Date\",\n        tickvals: tickvals,\n        ticktext: ticktext\n      }\n    }\n  }],\n  layout: {\n    xaxis: { title: x.name },\n    yaxis: { title: y.name }\n  }\n}\n\nreturn {}\n  ",
        "syncTimeRange": false,
        "timeCol": ""
      },
